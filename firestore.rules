rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Every shop's id IS its owner's auth uid, so who may touch a shop is decided
    // without reading any other document — no extra billed read per request, and no
    // lookup table that could go stale.
    function owns(shopId) {
      return request.auth != null && request.auth.uid == shopId;
    }

    // An owner closing their account sets `deleting` on their shop first, and only
    // then may the records below be removed. That keeps both promises at once: a
    // single inconvenient sale can never be quietly deleted while the shop is
    // trading, but an owner who wants out really can take everything with them.
    function closing(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data.deleting == true;
    }

    match /shops/{shopId} {
      allow read: if owns(shopId);

      // An owner may only ever open a shop under their own uid.
      allow create: if owns(shopId) && request.resource.data.ownerUid == shopId;

      // Details can be edited freely, but ownership cannot be handed to someone else.
      allow update: if owns(shopId) && request.resource.data.ownerUid == resource.data.ownerUid;

      // The shop document goes last, once everything beneath it is gone — deleting it
      // first would strand the rest, because `closing()` reads it.
      allow delete: if owns(shopId) && resource.data.deleting == true;

      // Stock. The owner of this shop, and nobody else.
      match /products/{productId} {
        allow read, write: if owns(shopId);
      }

      // Sales and deliveries are an audit trail: they may be created and read, but
      // never edited, and only deleted as part of closing the account. History must
      // stay trustworthy — it is the record of where stock went and who owes money.
      match /transactions/{transactionId} {
        allow read, create: if owns(shopId);
        allow update: if false;
        allow delete: if owns(shopId) && closing(shopId);
      }

      // Bill number counter. Only ever incremented inside a transaction.
      match /counters/{counterId} {
        allow read, write: if owns(shopId);
      }
    }

    // Username → login-email lookup, so a shop can sign in with its username even
    // though Firebase Auth only understands email addresses. The read has to happen
    // before anyone is signed in, so these documents are world-readable; that is the
    // cost of usernames, and they carry nothing but the email and the owner's uid.
    match /usernames/{username} {
      allow read: if true;

      // A name can be claimed once, by the account it points at — the email and uid
      // written must be the caller's own. Because this only fires when the document
      // does not yet exist, a second shop trying to take the same name is refused,
      // which is what keeps usernames unique.
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'email'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email;

      // Only the owner may move their own lookup to a new email (after changing it),
      // and never hand the name to a different account.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == request.auth.token.email;

      // A name is never freed — deleting it would let it be re-registered against a
      // different, now-stranded shop.
      allow delete: if false;
    }

    // Anything not named above is denied — including the old top-level products,
    // transactions and counters collections used before shops had their own space.
    // Those are left in the database as a backup of the first shop's data and are
    // read from the Firebase console, never by the app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
