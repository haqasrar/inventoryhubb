rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Stock. Anyone signed in with the shop login can manage products.
    match /products/{productId} {
      allow read, write: if signedIn();
    }

    // Sales and deliveries are an audit trail: they may be created and read,
    // but never edited or deleted. History must stay trustworthy — it is the
    // record of where the stock went and who owes money.
    match /transactions/{transactionId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // Bill number counter. Only ever incremented inside a transaction.
    match /counters/{counterId} {
      allow read, write: if signedIn();
    }

    // Anything not named above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
